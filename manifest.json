{
  "manifest_version": 3,
  "name": "MyTab",
  "version": "0.1.0",
  "minimum_chrome_version": "109",
  "description": "可定制的类原生浏览器起始页",

  "chrome_url_overrides": {
    "newtab": "index.html"
  },

  "host_permissions": [
    "https://bing.biturl.top/",
    "https://api.xinac.net/icon/*",
    "https://suggestion.baidu.com/su*",
    "https://suggestqueries.google.com/complete/*"
  ],

  "icons": {
    "16": "img/icon.png",
    "48": "img/icon.png",
    "128": "img/icon.png"
  }
}